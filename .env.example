# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/codecrack

# --- Auth (Auth.js / next-auth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-run-openssl-rand-base64-32

# Optional OAuth providers. Leave empty to hide the button.
# Google: https://console.cloud.google.com/apis/credentials  -> OAuth client (Web)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma separated emails that are always admins. (The first account ever created also becomes admin.)
ADMIN_EMAILS=

# --- Code runner ---
# Languages users can pick. Python is ready; cpp works if g++ is installed; java needs a JDK.
ENABLED_LANGUAGES=python
# Max programs judged at the same time
RUNNER_CONCURRENCY=4
PYTHON_BIN=python3
PYTHON_BIN=python3
# "local" (default): runs code directly with CPU/memory/output limits — fine on your own machine.
# "docker": isolates every run in a container (no network, read-only FS). Use this before letting other people submit code.
#   one-time setup: docker pull python:3.12-slim
RUNNER_SANDBOX=local
RUNNER_IMAGE=python:3.12-slim
